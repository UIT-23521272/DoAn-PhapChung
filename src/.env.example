# -----------------------------------------------------------------------------
# EXECUTION MODE
# LOCAL  → uses HuggingFace local embeddings (BAAI/bge-small-en), no cloud embed key needed
# API    → uses OpenAI embeddings (text-embedding-3-small), OPENAI_API_KEY required
# -----------------------------------------------------------------------------
EXECUTION_MODE = API


# -----------------------------------------------------------------------------
# LLM MODEL
# Format: provider/model-name  (passed to LangChain init_chat_model)
# Examples: openai/gpt-4o | google/gemini-2.5-pro | deepseek/deepseek-r1
# Can be overridden at runtime with: python run_agent.py --model provider/model
# -----------------------------------------------------------------------------
MODEL = openai/gpt-4o


# -----------------------------------------------------------------------------
# LLM PROVIDER API KEYS — fill in the key(s) matching your chosen MODEL above
# -----------------------------------------------------------------------------

# OpenAI (also required for embeddings when EXECUTION_MODE=API)
OPENAI_API_KEY =

# Google Gemini (required when MODEL starts with "google/")
GOOGLE_GENERATIVE_AI_API_KEY =

# DeepSeek (required when MODEL starts with "deepseek/")
DEEPSEEK_API_KEY =

# Anthropic Claude (required when MODEL starts with "anthropic/")
ANTHROPIC_API_KEY =


# -----------------------------------------------------------------------------
# GOOGLE CUSTOM SEARCH — used by the web_quick_search tool
# Keys must be numbered (GOOGLE_API_KEY_1, GOOGLE_API_KEY_2, ...)
# When one key's daily quota is exhausted the next available key is used.
# Get keys at: https://console.cloud.google.com/apis/credentials
# Get CSE ID at: https://programmablesearchengine.google.com/
# -----------------------------------------------------------------------------
GOOGLE_API_KEY_1 =
GOOGLE_API_KEY_2 =
GOOGLE_CSE_ID =


# -----------------------------------------------------------------------------
# NVD API KEY (optional)
# Raises rate limit from 5 → 50 requests per 30 s on the NIST NVD API.
# Request a free key at: https://nvd.nist.gov/developers/request-an-api-key
# Leave empty to use the public (unauthenticated) endpoint.
# -----------------------------------------------------------------------------
NVD_API_KEY =


# -----------------------------------------------------------------------------
# VIRUSTOTAL API KEY — used by the malware traffic analysis variant (Section 8.5)
# Required for IOC validation (IP, domain, file hash lookups) in run_agent_malware.py.
# Without this key the tool will still run but skip VirusTotal lookups.
# Free public API: 4 lookups/min, 500/day — sufficient for benchmark runs.
# Request a free key at: https://www.virustotal.com/gui/join-us
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY =


# -----------------------------------------------------------------------------
# CONTEXT & TOKEN SETTINGS
# -----------------------------------------------------------------------------

# Maximum tokens in the FIFO queue + working context — model specific
CONTEXT_WINDOW_SIZE = 400000

# Max input tokens sent to the pcap_flow_analyzer per TCP flow
TOKENS_BUDGET = 400000


# -----------------------------------------------------------------------------
# BENCHMARK SETTINGS
# -----------------------------------------------------------------------------

# Dataset to run: CFA (20-event CFA-benchmark) | test (10-event TestSet_benchmark)
DATASET = CFA

# How many events from the dataset to process (default: all)
NUMBER_OF_EVENTS = 20

# How many full runs over the selected events to perform
NUMBER_OF_EXECUTIONS = 1